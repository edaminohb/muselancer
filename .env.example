# Meta API key for muse-spark-1.3 and muse-wonder. Meta hosts the models. Leave empty until the Modal worker calls Meta.
MODEL_API_KEY=

# Modal tokens from `modal token new`. These start the worker and supervisor sandboxes. The model is not uploaded to Modal.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Privy app id from the Privy dashboard. Required. Sign-in and wallet signatures use this app.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy app secret from the Privy dashboard. Server only. The session route checks the Privy access token with it.
PRIVY_APP_SECRET=
# P-256 authorization key that owns the supervisor wallets. Server only. This is not an Ethereum private key.
# Dashboard: Wallets, Authorization keys, New key. Privy does not store the private key. Format: wallet-auth:<base64 PKCS8>.
PRIVY_AUTHORIZATION_KEY=

# Long random string, at least 32 characters. Signs the muselancer_session cookie and the runtime tokens. The app refuses a session while this is empty.
MUSELANCER_SECRET=

# Optional. Leave empty and the app registers one supervisor through Privy the first time a deal needs it. Privy holds the wallets. This value is an agent id, not a private key.
SUPERVISOR_AGENT_ID=

# OASF record name. Empty uses http://localhost:3000. Set an https origin when this app has a public host.
NEXT_PUBLIC_APP_URL=

# SQLite file for the desk cache and sealed mailboxes. This path is gitignored. Wallet private keys are not written here.
MUSELANCER_DB=data/muselancer.db

# Base Sepolia HTTPS RPC. Registration reads ownerOf, the agent wallet, and the registration file from this endpoint. https://sepolia.base.org works.
BASE_RPC_URL=

# Filebase S3 access key and secret from the Filebase console. Not a Firebase project.
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
# Filebase bucket name. The endpoint is https://s3.filebase.com.
FILEBASE_BUCKET=

# XMTP backend gRPC URL. The owner thread opens a browser client against this address.
XMTP_BACKEND_URL=

# Public Directory gRPC address on the VPS, for example 203.0.113.10:8888. https://host:443 uses TLS.
DIRECTORY_CLIENT_SERVER_ADDRESS=

# Set to 1 only after Prompt Guard weights are installed. Empty keeps the regex scanner.
MUSELANCER_REQUIRE_FIREWALL=

# Lit Chipotle API key. Leave empty unless ownerOf decrypt is turned on.
LIT_API_KEY=
